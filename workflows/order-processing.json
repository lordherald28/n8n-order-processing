    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH entrada AS (SELECT $1::jsonb AS pedido), nuevo_pedido AS (INSERT INTO public.pedidos (cliente, email, total, estado) SELECT pedido->>'cliente', pedido->>'email', (pedido->>'total')::numeric, CASE WHEN (pedido->>'total')::numeric > 1000 THEN 'PENDING_APPROVAL' ELSE 'PROCESSED' END FROM entrada RETURNING id), nuevos_productos AS (INSERT INTO public.productos (pedido_id, nombre, cantidad, precio) SELECT nuevo_pedido.id, producto->>'nombre', (producto->>'cantidad')::numeric, (producto->>'precio')::numeric FROM entrada CROSS JOIN nuevo_pedido CROSS JOIN LATERAL jsonb_array_elements(entrada.pedido->'productos') AS producto RETURNING id) SELECT nuevo_pedido.id, (SELECT count(*) FROM nuevos_productos) AS productos_guardados FROM nuevo_pedido;",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json.pedido)] }}"
        }
      },
