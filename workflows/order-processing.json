    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const p = $('POST /pedidos').item.json.body;\nconst motivos = [];\nconst texto = x => typeof x === 'string' && x.trim().length > 0;\n// Representa decimales como fracciones exactas.\nconst decimal = x => {\n  if (typeof x !== 'number' || !Number.isFinite(x)) return null;\n  const m = String(x).match(/^(-?)(\\d+)(?:\\.(\\d+))?(?:e([+-]?\\d+))?$/i);\n  if (!m) return null;\n  let n = BigInt(m[2] + (m[3] || '')) * (m[1] ? -1n : 1n);\n  let scale = (m[3] || '').length - Number(m[4] || 0);\n  if (scale < 0) {\n    n *= 10n ** BigInt(-scale);\n    scale = 0;\n  }\n  return { n, d: 10n ** BigInt(scale) };\n};\n// Reúne los motivos de validación del pedido.\nif (!p || typeof p !== 'object' || Array.isArray(p)) motivos.push('El pedido debe ser un objeto JSON');\nif (!texto(p?.cliente)) motivos.push('cliente es obligatorio');\nif (!texto(p?.email)) motivos.push('email es obligatorio');\nelse if (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(p.email)) motivos.push('email tiene formato inválido');\nlet sumN = 0n, sumD = 1n, calculable = true;\nif (!Array.isArray(p?.productos) || p.productos.length === 0) {\n  motivos.push('productos debe contener al menos un producto');\n  calculable = false;\n} else {\n  p.productos.forEach((prod, i) => {\n    if (!texto(prod?.nombre)) motivos.push('productos[' + i + '].nombre es obligatorio');\n    const q = decimal(prod?.cantidad), price = decimal(prod?.precio);\n    if (!q || q.n <= 0n) { motivos.push('productos[' + i + '].cantidad debe ser un número positivo'); calculable = false; }\n    if (!price) { motivos.push('productos[' + i + '].precio es obligatorio y debe ser numérico'); calculable = false; }\n    if (q && q.n > 0n && price) {\n      // Acumula el importe exacto expresado en centavos.\n      const n = q.n * price.n * 100n, d = q.d * price.d;\n      sumN = sumN * d + n * sumD;\n      sumD *= d;\n    }\n  });\n}\n// Compara el total sin redondear valores binarios.\nconst total = decimal(p?.total);\nif (!total) motivos.push('total es obligatorio y debe ser numérico');\nelse if (calculable && sumN * total.d !== total.n * 100n * sumD) motivos.push('total no coincide con la suma de cantidad por precio');\nreturn { json: { pedido: p ?? null, valido: motivos.length === 0, motivos } };"
      },
