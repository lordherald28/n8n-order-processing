        "query": "UPDATE public.pedidos SET estado = CASE WHEN $2::boolean THEN 'APPROVED' ELSE 'REJECTED' END WHERE id = $1::bigint AND estado = 'PENDING_APPROVAL' AND $2::boolean IS NOT NULL RETURNING id, estado;",
