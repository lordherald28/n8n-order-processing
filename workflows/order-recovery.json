    {
      "id": "75b4de86-efdf-425e-afe7-dc48172711a3",
      "name": "Recuperar pedido",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        896,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH entrada AS (SELECT $1::jsonb AS pedido, $2::text AS clave, $3::text AS recepcion), guardado AS (\n INSERT INTO public.pedidos (cliente,email,total,estado,idempotency_key,recepcion_id,solicitud_original,aprobacion_intentada)\n SELECT pedido->>'cliente',pedido->>'email',(pedido->>'total')::numeric,\n CASE WHEN (pedido->>'total')::numeric > 1000 THEN 'PENDING_APPROVAL' ELSE 'PROCESSED' END,\n clave,recepcion,pedido,CASE WHEN (pedido->>'total')::numeric > 1000 THEN true ELSE false END FROM entrada\n ON CONFLICT (idempotency_key) WHERE idempotency_key IS NOT NULL DO UPDATE SET idempotency_key=EXCLUDED.idempotency_key\n RETURNING id, solicitud_original, (xmax=0) AS nuevo\n), productos_nuevos AS (\n INSERT INTO public.productos (pedido_id,nombre,cantidad,precio)\n SELECT g.id,p->>'nombre',(p->>'cantidad')::numeric,(p->>'precio')::numeric FROM guardado g CROSS JOIN entrada e CROSS JOIN LATERAL jsonb_array_elements(e.pedido->'productos') p WHERE g.nuevo RETURNING id\n)\nSELECT g.id,g.nuevo,(g.solicitud_original=e.pedido) AS coincide,(SELECT count(*) FROM productos_nuevos) AS productos_guardados FROM guardado g CROSS JOIN entrada e;",
        "options": {
          "queryReplacement": "={{ [$json.pedido, ($json.idempotency_key || '').trim() ? 'header:' + $json.idempotency_key.trim() : 'recepcion:' + $json.recepcion_id, String($json.recepcion_id)] }}"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
